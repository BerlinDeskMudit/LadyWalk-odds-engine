# EditorConfig — https://editorconfig.org
# Keeps formatting consistent across every contributor's editor, which matters
# once the diff is reviewed by people who do not share your setup.
# .gitattributes remains authoritative for what is actually committed.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces is a hard line break in Markdown, so do not strip them.
trim_trailing_whitespace = false

[*.{rs,toml}]
indent_size = 4

[*.{py,sh,bash}]
indent_size = 4

[Makefile]
indent_style = tab
