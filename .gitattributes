# Normalise text files in the repo, check them out with native line endings.
* text=auto eol=lf

*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt  text eol=lf

# Never touch these - they are binary or need exact bytes
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.sqlite binary
*.db    binary
*.lock  text eol=lf
